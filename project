                        <circle cx="16" cy="33" r="5" fill="#fca5a5" />
                        <path d="M 86 65 Q 92 45 84 35" stroke="#fca5a5" stroke-width="6" stroke-linecap="round" fill="none"/>
                        <circle cx="84" cy="33" r="5" fill="#fca5a5" />
                    `;
                    break;

                case 'wrong':
                case 'sad':
                    // Sweat Drop & Apologetic Mouth
                    eyesHtml = `
                        <ellipse cx="38" cy="42" rx="4" ry="6" fill="#1e1b4b" />
                        <ellipse cx="62" cy="42" rx="4" ry="6" fill="#1e1b4b" />
                        <path d="M 32 35 Q 38 38 44 36" stroke="#1e1b4b" stroke-width="2.5" fill="none" />
                        <path d="M 56 36 Q 62 38 68 35" stroke="#1e1b4b" stroke-width="2.5" fill="none" />
                    `;
                    mouthHtml = `<circle cx="50" cy="58" r="4.5" stroke="#1e1b4b" stroke-width="2.5" fill="none"/>`;
                    extraHtml = `<text x="72" y="28" font-size="14">💧</text>`;
                    armHandHtml = `
                        <!-- Hand on head -->
                        <path d="M 78 70 Q 88 50 70 30" stroke="#fca5a5" stroke-width="5" stroke-linecap="round" fill="none"/>
                        <circle cx="68" cy="28" r="5" fill="#fca5a5" />
                    `;
                    break;

                case 'thinking':
                case 'curious':
                    // Hand on chin, looking up
                    eyesHtml = `
                        <ellipse cx="38" cy="40" rx="5" ry="6" fill="#1e1b4b" />
                        <ellipse cx="62" cy="40" rx="5" ry="6" fill="#1e1b4b" />
                        <circle cx="40" cy="38" r="2" fill="#ffffff" />
                        <circle cx="64" cy="38" r="2" fill="#ffffff" />
                        <!-- Eyebrow raised -->
                        <path d="M 32 32 Q 38 28 44 32" stroke="#1e1b4b" stroke-width="2.5" fill="none" />
                        <path d="M 56 30 Q 62 25 68 30" stroke="#1e1b4b" stroke-width="2.5" fill="none" />
                    `;
                    mouthHtml = `<path d="M 40 58 Q 50 54 60 58" stroke="#1e1b4b" stroke-width="2.5" stroke-linecap="round" fill="none"/>`;
                    extraHtml = `<text x="74" y="22" font-size="12">💡</text>`;
                    armHandHtml = `
                        <!-- Hand thinking under chin -->
                        <path d="M 60 78 Q 72 65 58 60" stroke="#fca5a5" stroke-width="5.5" stroke-linecap="round" fill="none"/>
                        <circle cx="56" cy="60" r="5" fill="#fca5a5" />
                    `;
                    break;

                default: // Winking / Happy Welcome
                    eyesHtml = `
                        <!-- One Eye Open, One Winking -->
                        <ellipse cx="36" cy="42" rx="5" ry="7" fill="#1e1b4b" />
                        <circle cx="38" cy="40" r="2" fill="#ffffff" />
                        <path d="M 56 42 Q 62 48 68 42" stroke="#1e1b4b" stroke-width="3" stroke-linecap="round" fill="none"/>
                    `;
                    mouthHtml = `<path d="M 36 55 Q 50 68 64 55" stroke="#1e1b4b" stroke-width="3.5" stroke-linecap="round" fill="none" />`;
                    extraHtml = `<text x="72" y="22" font-size="11">✨</text>`;
                    armHandHtml = `
                        <path d="M 18 70 Q 10 58 14 48" stroke="#fca5a5" stroke-width="5" stroke-linecap="round" fill="none"/>
                        <circle cx="14" cy="46" r="4.5" fill="#fca5a5" />
                    `;
                    break;
            }

            return `
                <!-- Boy Character Container -->
                <circle cx="50" cy="50" r="44" fill="url(#boyBgGrad)" />
                <defs>
                    <linearGradient id="boyBgGrad" x1="0" y1="0" x2="100" y2="100">
                        <stop offset="0%" stop-color="#f472b6"/>
                        <stop offset="100%" stop-color="#fbbf24"/>
                    </linearGradient>
                </defs>

                <!-- Hoodie / Shoulders -->
                <path d="M 20 90 C 20 72, 80 72, 80 90 Z" fill="#db2777" />
                <path d="M 36 76 L 50 90 L 64 76 Z" fill="#fbcfe8" />

                <!-- Neck -->
                <rect x="44" y="62" width="12" height="12" rx="3" fill="#fca5a5" />

                <!-- Face -->
                <ellipse cx="50" cy="48" rx="26" ry="24" fill="#fca5a5" />
                <!-- Ears -->
                <circle cx="24" cy="48" r="5" fill="#fca5a5" />
                <circle cx="76" cy="48" r="5" fill="#fca5a5" />

                ${baseHairCap}
                ${eyesHtml}
                ${cheeksHtml}
                ${mouthHtml}
                ${armHandHtml}
                ${extraHtml}
            `;
        }

        class IPQuizApp {
            constructor() {
                this.questions = CLASS12_IP_QUESTIONS;
                this.currentIndex = 0;
                this.score = 0;
                this.streak = 0;
                this.maxStreak = 0;
                this.correctCount = 0;
                this.wrongCount = 0;
                this.userAnswers = [];
                this.used5050 = false;
                this.usedHint = false;

                this.bindEvents();
                this.initWelcomeAvatar();
            }

            initWelcomeAvatar() {
                const welcSvg = document.getElementById('welcomeAvatarSvg');
                if (welcSvg) welcSvg.innerHTML = generateBoyCharacterSvg('happy');
            }

            bindEvents() {
                document.getElementById('startQuizBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    this.startQuiz();
                });
                document.getElementById('nextBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    this.nextQuestion();
                });
                document.getElementById('quitBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    if (confirm("Are you sure you want to return to home screen?")) {
                        this.resetToHome();
                    }
                });
                document.getElementById('retakeQuizBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    this.startQuiz();
                });
                document.getElementById('viewReviewBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    this.showReviewScreen();
                });
                document.getElementById('backToResultBtn').addEventListener('click', () => {
                    audioSynth.playClick();
                    this.showScreen('resultScreen');
                });

                // Sound toggle
                document.getElementById('soundToggleBtn').addEventListener('click', () => {
                    const enabled = audioSynth.toggleSound();
                    const icon = document.getElementById('soundIcon');
                    icon.className = enabled ? 'fa-solid fa-volume-high text-amber-300' : 'fa-solid fa-volume-xmark text-blush-400';
                });

                // Lifelines
                document.getElementById('lifeline5050').addEventListener('click', () => this.use5050Lifeline());
                document.getElementById('lifelineHint').addEventListener('click', () => this.useHintLifeline());
            }

            showScreen(id) {
                ['welcomeScreen', 'quizScreen', 'resultScreen', 'reviewScreen'].forEach(s => {
                    document.getElementById(s).classList.add('hidden');
                });
                document.getElementById(id).classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            resetToHome() {
                document.body.className = "bg-soft-blush text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500";
                this.showScreen('welcomeScreen');
            }

            startQuiz() {
                this.questions = [...CLASS12_IP_QUESTIONS].sort(() => Math.random() - 0.5);
                this.currentIndex = 0;
                this.score = 0;
                this.streak = 0;
                this.maxStreak = 0;
                this.correctCount = 0;
                this.wrongCount = 0;
                this.userAnswers = [];
                this.used5050 = false;
                this.usedHint = false;

                document.getElementById('lifeline5050').disabled = false;
                document.getElementById('lifelineHint').disabled = false;

                this.showScreen('quizScreen');
                this.renderQuestion();
            }

            renderQuestion() {
                const q = this.questions[this.currentIndex];
                const total = this.questions.length;

                document.body.className = "bg-soft-blush text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500";
                
                // Hide Banner & Hint
                document.getElementById('feedbackBanner').classList.add('hidden');
                document.getElementById('hintBox').classList.add('hidden');

                // Counters & Progress
                document.getElementById('questionCounter').innerHTML = `<i class="fa-solid fa-heart text-blush-400"></i> Question ${this.currentIndex + 1} of ${total}`;
                document.getElementById('scoreTracker').innerText = `Score: ${this.score} / 50`;
                document.getElementById('progressBar').style.width = `${((this.currentIndex + 1) / total) * 100}%`;

                // Streak Badge Update
                const streakBadge = document.getElementById('streakBadge');
                if (this.streak >= 2) {
                    streakBadge.classList.remove('hidden');
                    document.getElementById('streakText').innerText = `${this.streak}x STREAK COMBO!`;
                } else {
                    streakBadge.classList.add('hidden');
                }

                // Mascot Avatar State
                const charSvg = document.getElementById('questionCharacterSvg');
                const stateText = document.getElementById('characterStateText');
                const charState = q.charState || 'happy';

                charSvg.innerHTML = generateBoyCharacterSvg(charState);

                if (charState === 'thinking') stateText.innerText = '"Think carefully about the syntax..."';
                else if (charState === 'curious') stateText.innerText = '"Intriguing Python question!"';
                else if (charState === 'cheering') stateText.innerText = '"Cheering for your full score!"';
                else stateText.innerText = '"Priyanshu Gupta is here to assist!"';

                // Question Details
                document.getElementById('categoryTag').innerText = q.category || 'Python IP';
                document.getElementById('questionText').innerText = q.q;

                // Code snippet
                const codeBox = document.getElementById('codeSnippetBox');
                const codeText = document.getElementById('codeSnippetText');
                if (q.code) {
                    codeText.innerText = q.code;
                    codeBox.classList.remove('hidden');
                } else {
                    codeBox.classList.add('hidden');
                }

                // Render 4 Options
                const container = document.getElementById('optionsContainer');
                container.innerHTML = '';

                q.options.forEach((opt, idx) => {
                    const btn = document.createElement('button');
                    btn.className = `option-btn w-full p-3.5 sm:p-4 rounded-2xl border border-blush-500/30 bg-blush-950/60 hover:bg-blush-900/80 hover:border-amber-300/80 font-semibold text-left flex items-center justify-between transition-all duration-200 text-xs sm:text-sm text-blush-100 group shadow-md`;
                    btn.dataset.index = idx;

                    btn.innerHTML = `
                        <div class="flex items-center gap-3">
                            <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-blush-900/80 border border-blush-500/40 flex items-center justify-center font-bold text-xs text-amber-300 group-hover:bg-amber-300 group-hover:text-blush-950 transition-colors shrink-0">
                                ${String.fromCharCode(65 + idx)}
                            </span>
                            <span>${opt}</span>
                        </div>
                        <i class="status-icon fa-regular fa-heart text-blush-400/60 text-base shrink-0"></i>
                    `;

                    btn.addEventListener('click', () => this.handleOptionSelect(idx, btn));
                    container.appendChild(btn);
                });

                // Next Button
                const nextBtn = document.getElementById('nextBtn');
                nextBtn.disabled = true;
                document.getElementById('nextBtnText').innerText = (this.currentIndex === total - 1) ? 'Finish & See Scorecard' : 'Next Question';
            }

            use5050Lifeline() {
                if (this.used5050) return;
                this.used5050 = true;
                document.getElementById('lifeline5050').disabled = true;

                const q = this.questions[this.currentIndex];
                const incorrectIndices = [0, 1, 2, 3].filter(i => i !== q.correct);
                
                incorrectIndices.sort(() => Math.random() - 0.5);
                const toRemove = incorrectIndices.slice(0, 2);

                const buttons = document.querySelectorAll('.option-btn');
                buttons.forEach(btn => {
                    const idx = parseInt(btn.dataset.index);
                    if (toRemove.includes(idx)) {
                        btn.classList.add('opacity-30', 'pointer-events-none');
                        btn.innerHTML = `<span class="italic text-xs text-blush-400/50">✨ Removed by 50:50 Lifeline</span>`;
                    }
                });

                audioSynth.playClick();
            }

            useHintLifeline() {
                if (this.usedHint) return;
                this.usedHint = true;
                document.getElementById('lifelineHint').disabled = true;

                const q = this.questions[this.currentIndex];
                const hintBox = document.getElementById('hintBox');
                document.getElementById('hintText').innerText = q.hint || "Review core Class 12 IP syllabus rules!";
                hintBox.classList.remove('hidden');

                audioSynth.playClick();
            }

            handleOptionSelect(selectedIndex, selectedBtn) {
                const q = this.questions[this.currentIndex];
                const isCorrect = selectedIndex === q.correct;
                const allButtons = document.querySelectorAll('.option-btn');

                allButtons.forEach(b => b.classList.add('pointer-events-none'));

                const feedbackBanner = document.getElementById('feedbackBanner');
                const feedbackText = document.getElementById('feedbackText');
                const feedbackIcon = document.getElementById('feedbackIcon');
                const charSvg = document.getElementById('questionCharacterSvg');
                const stateText = document.getElementById('characterStateText');

                if (isCorrect) {
                    // CORRECT ANSWER
                    this.score += 2;
                    this.correctCount++;
                    this.streak++;
                    if (this.streak > this.maxStreak) this.maxStreak = this.streak;

                    audioSynth.playJoyfulCrackersSound();
                    if (this.streak >= 2) audioSynth.playStreakSound();

                    fireworks.triggerMultipleBurst();
                    this.spawnFloatingElements();

                    document.body.className = "bg-soft-blush celebrate-bg text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500";

                    charSvg.innerHTML = generateBoyCharacterSvg('correct');
                    stateText.innerText = this.streak >= 2 ? `"${this.streak}x STREAK! AWESOME SPEED! 🎆"` : '"YES! 100% Correct Answer! 🎆"';

                    selectedBtn.classList.remove('border-blush-500/30', 'bg-blush-950/60');
                    selectedBtn.classList.add('border-emerald-400', 'bg-emerald-500/25', 'text-emerald-200', 'shadow-xl', 'shadow-emerald-500/20');
                    selectedBtn.querySelector('.status-icon').className = 'status-icon fa-solid fa-circle-check text-emerald-300 text-lg';

                    feedbackBanner.classList.remove('hidden');
                    feedbackBanner.className = 'mb-4 p-3 rounded-2xl font-bold text-center text-xs sm:text-sm transition-all animate-pop-in flex items-center justify-center gap-2 shadow-lg bg-emerald-500/20 border border-emerald-400/40 text-emerald-200';
                    feedbackIcon.innerText = '🎆';
                    feedbackText.innerText = `EXCELLENT! (+2 Marks) ${this.streak >= 2 ? `🔥 ${this.streak}x Streak Combo!` : ''}`;

                } else {
                    // WRONG ANSWER
                    this.wrongCount++;
                    this.streak = 0;
                    audioSynth.playSadSound();

                    const qCard = document.getElementById('questionCard');
                    qCard.classList.add('animate-shake');
                    setTimeout(() => qCard.classList.remove('animate-shake'), 450);

                    document.body.className = "bg-soft-blush sad-bg text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500";

                    charSvg.innerHTML = generateBoyCharacterSvg('wrong');
                    stateText.innerText = '"Oops! Don\'t worry, learn from this!"';

                    selectedBtn.classList.remove('border-blush-500/30', 'bg-blush-950/60');
                    selectedBtn.classList.add('border-rose-500', 'bg-rose-500/25', 'text-blush-200');
                    selectedBtn.querySelector('.status-icon').className = 'status-icon fa-solid fa-circle-xmark text-blush-400 text-lg';

                    const correctBtn = allButtons[q.correct];
                    correctBtn.classList.remove('border-blush-500/30', 'bg-blush-950/60');
                    correctBtn.classList.add('border-emerald-400', 'bg-emerald-500/25', 'text-emerald-200');
                    correctBtn.querySelector('.status-icon').className = 'status-icon fa-solid fa-circle-check text-emerald-300 text-lg';

                    feedbackBanner.classList.remove('hidden');
                    feedbackBanner.className = 'mb-4 p-3 rounded-2xl font-bold text-center text-xs sm:text-sm transition-all animate-pop-in flex items-center justify-center gap-2 shadow-lg bg-rose-500/20 border border-blush-400/40 text-blush-200';
                    feedbackIcon.innerText = '🌸';
                    feedbackText.innerText = `Correct Choice: Option ${String.fromCharCode(65 + q.correct)}: ${q.options[q.correct]}`;
                }

                document.getElementById('scoreTracker').innerText = `Score: ${this.score} / 50`;

                this.userAnswers.push({
                    question: q.q,
                    code: q.code,
                    options: q.options,
                    selected: selectedIndex,
                    correct: q.correct,
                    isCorrect: isCorrect,
                    explanation: q.explanation
                });

                document.getElementById('nextBtn').disabled = false;
            }

            nextQuestion() {
                if (this.currentIndex < this.questions.length - 1) {
                    this.currentIndex++;
                    this.renderQuestion();
                } else {
                    this.finishQuiz();
                }
            }

            finishQuiz() {
                document.body.className = "bg-soft-blush text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500";
                
                const percentage = Math.round((this.score / 50) * 100);

                document.getElementById('finalScoreDisplay').innerText = this.score;
                document.getElementById('percentageDisplay').innerText = `${percentage}% Score`;
                document.getElementById('correctAnswersCount').innerText = this.correctCount;
                document.getElementById('wrongAnswersCount').innerText = this.wrongCount;
                document.getElementById('maxStreakCount').innerText = `${this.maxStreak}x`;

                const title = document.getElementById('resultGradeTitle');
                const sub = document.getElementById('resultSubtitle');
                const resSvg = document.getElementById('resultCharacterSvg');
                const rankTag = document.getElementById('rankBadgeTag');

                if (percentage >= 80) {
                    rankTag.innerText = "👑 PYTHON CHAMPION";
                    title.innerText = "Outstanding Mastery!";
                    sub.innerText = "Priyanshu Gupta congratulates you on full Class 12 IP Python mastery!";
                    resSvg.innerHTML = generateBoyCharacterSvg('cheering');
                    fireworks.triggerMultipleBurst();
                } else if (percentage >= 50) {
                    rankTag.innerText = "💖 IP STAR SCHOLAR";
                    title.innerText = "Great Performance!";
                    sub.innerText = "Well done! Review the answers to boost your score to 100%!";
                    resSvg.innerHTML = generateBoyCharacterSvg('happy');
                } else {
                    rankTag.innerText = "✨ PYTHON EXPLORER";
                    title.innerText = "Good Effort!";
                    sub.innerText = "Review Priyanshu's explanations below and give it another try!";
                    resSvg.innerHTML = generateBoyCharacterSvg('thinking');
                }

                this.showScreen('resultScreen');
            }

            showReviewScreen() {
                const container = document.getElementById('reviewCardsContainer');
                container.innerHTML = '';

                this.userAnswers.forEach((ans, idx) => {
                    const card = document.createElement('div');
                    card.className = `p-4 rounded-2xl border ${
                        ans.isCorrect ? 'border-emerald-500/40 bg-emerald-500/10' : 'border-rose-500/40 bg-rose-500/10'
                    } transition-all`;

                    card.innerHTML = `
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <span class="font-bold text-xs sm:text-sm text-white">Q${idx + 1}. ${ans.question}</span>
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold shrink-0 ${
                                ans.isCorrect ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-300 border border-rose-500/30'
                            }">
                                ${ans.isCorrect ? '+2 Marks' : '0 Marks'}
                            </span>
                        </div>
                        ${ans.code ? `<pre class="mb-2.5 p-2 rounded-lg bg-slate-950 text-xs text-emerald-300 font-mono overflow-x-auto"><code>${ans.code}</code></pre>` : ''}
                        <div class="text-xs space-y-1 mb-2">
                            <div class="${ans.isCorrect ? 'text-emerald-300' : 'text-blush-300'} font-semibold">
                                <i class="fa-solid ${ans.isCorrect ? 'fa-check' : 'fa-xmark'} mr-1"></i> Your Answer: Option ${String.fromCharCode(65 + ans.selected)} (${ans.options[ans.selected]})
                            </div>
                            ${!ans.isCorrect ? `
                                <div class="text-emerald-300 font-semibold">
                                    <i class="fa-solid fa-check mr-1"></i> Correct Answer: Option ${String.fromCharCode(65 + ans.correct)} (${ans.options[ans.correct]})
                                </div>
                            ` : ''}
                        </div>
                        <div class="text-xs text-blush-100 bg-blush-950/80 p-2.5 rounded-xl border border-blush-800/60 leading-relaxed font-romantic">
                            <span class="font-bold text-amber-300">Priyanshu's Explanation:</span> ${ans.explanation}
                        </div>
                    `;
                    container.appendChild(card);
                });

                this.showScreen('reviewScreen');
            }

            spawnFloatingElements() {
                const elements = ['💖', '🌸', '✨', '💕', '⭐', '🌺', '🎆'];
                for (let i = 0; i < 8; i++) {
                    const span = document.createElement('span');
                    span.className = 'floating-element';
                    span.innerText = elements[Math.floor(Math.random() * elements.length)];
                    span.style.left = `${10 + Math.random() * 80}%`;
                    span.style.top = `${50 + Math.random() * 20}%`;
                    document.body.appendChild(span);

                    setTimeout(() => span.remove(), 2200);
                }
            }
        }

        // Initialize App
        let quizApp;
        window.addEventListener('DOMContentLoaded', () => {
            quizApp = new IPQuizApp();
        });
    </script>
</body>
</html>
