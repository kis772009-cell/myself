<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class 12 IP Python - Quiz by Priyanshu Gupta</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Comfortaa:wght@700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Fredoka', 'cursive'],
                        romantic: ['Comfortaa', 'cursive'],
                    },
                    colors: {
                        softpink: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                            800: '#9f1239',
                            900: '#4c0519',
                        },
                        blush: {
                            100: '#fce7f3',
                            200: '#fbcfe8',
                            300: '#f472b6',
                            400: '#e879f9',
                            500: '#ec4899',
                            600: '#db2777',
                            700: '#be185d',
                            800: '#9d174d',
                            900: '#500724',
                        },
                        joyful: {
                            gold: '#fbbf24',
                            amber: '#f59e0b',
                            emerald: '#10b981',
                            mint: '#34d399'
                        }
                    },
                    animation: {
                        'float-slow': 'float 5s ease-in-out infinite',
                        'float-fast': 'float 3s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 2.2s ease-in-out infinite',
                        'shake': 'shake 0.4s cubic-bezier(.36,.07,.19,.97) both',
                        'pop-in': 'popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                        'boy-bounce': 'boyBounce 1.8s ease-in-out infinite',
                        'sparkle-spin': 'sparkleSpin 8s linear infinite',
                        'heart-beat': 'heartBeat 1.3s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
                            '50%': { transform: 'translateY(-12px) rotate(4deg)' },
                        },
                        boyBounce: {
                            '0%, 100%': { transform: 'translateY(0px) scale(1)' },
                            '50%': { transform: 'translateY(-8px) scale(1.03)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { boxShadow: '0 0 20px rgba(244, 114, 182, 0.4), 0 0 40px rgba(251, 191, 36, 0.25)' },
                            '50%': { boxShadow: '0 0 38px rgba(244, 114, 182, 0.7), 0 0 65px rgba(251, 191, 36, 0.45)' },
                        },
                        shake: {
                            '10%, 90%': { transform: 'translate3d(-2px, 0, 0)' },
                            '20%, 80%': { transform: 'translate3d(4px, 0, 0)' },
                            '30%, 50%, 70%': { transform: 'translate3d(-6px, 0, 0)' },
                            '40%, 60%': { transform: 'translate3d(6px, 0, 0)' },
                        },
                        popIn: {
                            '0%': { opacity: '0', transform: 'scale(0.88) translateY(12px)' },
                            '100%': { opacity: '1', transform: 'scale(1) translateY(0)' },
                        },
                        sparkleSpin: {
                            '0%': { transform: 'rotate(0deg)' },
                            '100%': { transform: 'rotate(360deg)' }
                        },
                        heartBeat: {
                            '0%, 100%': { transform: 'scale(1)' },
                            '50%': { transform: 'scale(1.15)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Soft Blush & Velvet Theme Background */
        .bg-soft-blush {
            background: linear-gradient(135deg, #2b0312 0%, #4a0722 25%, #500724 50%, #3d0520 75%, #1a010b 100%);
            background-attachment: fixed;
        }

        .bg-soft-blush::before {
            content: '';
            position: fixed;
            inset: 0;
            background: 
                radial-gradient(circle at 15% 18%, rgba(244, 114, 182, 0.25) 0%, transparent 45%),
                radial-gradient(circle at 85% 25%, rgba(251, 191, 36, 0.2) 0%, transparent 45%),
                radial-gradient(circle at 50% 85%, rgba(236, 72, 153, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(192, 132, 252, 0.18) 0%, transparent 40%);
            pointer-events: none;
            z-index: 0;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(50, 7, 36, 0.82);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(251, 207, 232, 0.25);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        /* Celebration Glow */
        .celebrate-bg {
            background: radial-gradient(circle, rgba(16, 185, 129, 0.35) 0%, rgba(52, 211, 153, 0.12) 60%, transparent 100%);
            transition: all 0.4s ease;
        }

        /* Sad Tone Overlay */
        .sad-bg {
            background: radial-gradient(circle, rgba(225, 29, 72, 0.32) 0%, rgba(190, 18, 60, 0.12) 60%, transparent 100%);
            transition: all 0.4s ease;
        }

        /* Interactive Canvases */
        #fireworksCanvas, #cursorCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 95;
        }

        #cursorCanvas {
            z-index: 90;
        }

        /* Floating Interactive Elements */
        .floating-element {
            position: absolute;
            pointer-events: none;
            animation: elementFloat 2.2s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
            z-index: 60;
            font-size: 2.2rem;
            filter: drop-shadow(0 0 12px rgba(244, 114, 182, 0.85));
        }

        @keyframes elementFloat {
            0% { opacity: 1; transform: translateY(0) scale(0.6) rotate(0deg); }
            50% { opacity: 0.9; transform: translateY(-80px) scale(1.35) rotate(15deg); }
            100% { opacity: 0; transform: translateY(-160px) scale(1.7) rotate(-15deg); }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(30, 2, 12, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(244, 114, 182, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(244, 114, 182, 0.85);
        }
    </style>
</head>
<body class="bg-soft-blush text-blush-100 min-h-screen flex flex-col justify-between font-sans relative overflow-x-hidden transition-all duration-500 selection:bg-blush-500 selection:text-white">

    <canvas id="cursorCanvas"></canvas>
    <canvas id="fireworksCanvas"></canvas>

    <!-- Floating Background Decor -->
    <div id="particlesContainer" class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <span class="absolute top-10 left-[7%] text-3xl opacity-30 animate-float-slow">💖</span>
        <span class="absolute top-1/4 right-[9%] text-4xl opacity-25 animate-float-fast">✨</span>
        <span class="absolute bottom-1/3 left-[5%] text-4xl opacity-30 animate-float-fast">🌸</span>
        <span class="absolute bottom-10 right-[12%] text-3xl opacity-25 animate-float-slow">💕</span>
        <span class="absolute top-1/2 left-[88%] text-3xl opacity-25 animate-float-slow">🐍</span>
        <span class="absolute top-16 right-[28%] text-2xl opacity-20 animate-float-fast">🎆</span>
    </div>

    <header class="relative z-10 w-full border-b border-blush-800/60 bg-blush-950/60 backdrop-blur-md">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="quizApp.resetToHome()">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blush-500 via-blush-300 to-amber-300 flex items-center justify-center text-slate-900 shadow-lg font-bold text-xl animate-pulse-glow">
                    <i class="fa-brands fa-python text-2xl text-blush-950"></i>
                </div>
                <div>
                    <span class="font-display font-extrabold text-lg sm:text-xl bg-gradient-to-r from-blush-200 via-pink-100 to-amber-200 bg-clip-text text-transparent">Class 12 IP Python</span>
                    <span class="text-[10px] block font-bold text-blush-300 uppercase tracking-widest">Mentor: PRIYANSHU GUPTA</span>
                </div>
            </div>

            <!-- Header Sound & Max Marks Controls -->
            <div class="flex items-center space-x-3">
                <button id="soundToggleBtn" class="p-2.5 rounded-full bg-blush-900/60 border border-blush-400/30 text-blush-200 hover:text-amber-300 hover:bg-blush-800 transition-all text-xs flex items-center gap-1.5 px-3">
                    <i id="soundIcon" class="fa-solid fa-volume-high text-amber-300"></i>
                    <span class="hidden sm:inline font-bold">Sound ON</span>
                </button>

                <div class="flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-amber-500/20 to-blush-500/20 border border-amber-400/40 text-amber-300 font-bold text-xs shadow-sm">
                    <i class="fa-solid fa-crown text-amber-300"></i>
                    <span>Max: 50 Marks</span>
                </div>
            </div>
        </div>
    </header>

    <main class="relative z-10 max-w-4xl mx-auto px-4 py-6 sm:px-6 w-full flex-grow flex items-center justify-center">

        <!-- ================= 1. WELCOME SCREEN ================= -->
        <section id="welcomeScreen" class="w-full text-center animate-pop-in py-2">
            
            <!-- Animated Boy Character Banner (Priyanshu Gupta) -->
            <div class="relative inline-block mb-4">
                <div class="relative w-36 h-36 sm:w-44 sm:h-44 mx-auto rounded-full bg-gradient-to-tr from-blush-400 via-pink-300 to-amber-300 p-1.5 shadow-2xl shadow-blush-500/40 animate-pulse-glow">
                    <div class="w-full h-full bg-blush-950 rounded-full flex items-center justify-center relative overflow-hidden border-2 border-blush-300/40">
                        <svg id="welcomeAvatarSvg" class="w-32 h-32 sm:w-40 sm:h-40 animate-boy-bounce" viewBox="0 0 100 100" fill="none">
                            <!-- Injected dynamically -->
                        </svg>
                    </div>
                </div>
                <span class="inline-block mt-3 px-4 py-1.5 rounded-full text-xs font-extrabold bg-gradient-to-r from-blush-500/30 via-pink-500/30 to-amber-500/30 text-blush-100 border border-blush-400/40 shadow-sm">
                    ✨ PRIYANSHU GUPTA: Your AI Python Guide! ✨
                </span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-display font-extrabold tracking-tight mb-2 text-white">
                Master <span class="bg-gradient-to-r from-blush-200 via-pink-200 to-amber-200 bg-clip-text text-transparent">Class 12 IP Python!</span>
            </h1>
            <p class="text-blush-200/90 max-w-xl mx-auto text-sm sm:text-base mb-6 leading-relaxed font-romantic">
                Join Priyanshu Gupta in this interactive 25-question Python quiz with firecracker bursts, streak multipliers, and instant feedback!
            </p>

            <!-- Rules Card -->
            <div class="glass-card rounded-3xl p-5 sm:p-7 mb-7 text-left max-w-2xl mx-auto relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 text-7xl opacity-10">💖</div>
                <h3 class="font-display font-bold text-lg text-amber-300 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-sparkles text-blush-300"></i> Interactive Quiz Highlights
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm text-blush-100">
                    <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-blush-950/70 border border-blush-500/30">
                        <div class="w-9 h-9 rounded-2xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0 font-extrabold text-sm border border-emerald-500/40">
                            +2
                        </div>
                        <div>
                            <span class="font-bold text-white block">Right Answer</span>
                            <span class="text-xs text-blush-300">+2 Marks + Firecrackers Burst 🎆</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-blush-950/70 border border-blush-500/30">
                        <div class="w-9 h-9 rounded-2xl bg-amber-500/20 text-amber-300 flex items-center justify-center shrink-0 font-extrabold text-sm border border-amber-500/40">
                            🔥
                        </div>
                        <div>
                            <span class="font-bold text-white block">Streak Combos</span>
                            <span class="text-xs text-blush-300">Build 2x, 3x, 5x streaks for bonus callouts!</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-blush-950/70 border border-blush-500/30">
                        <div class="w-9 h-9 rounded-2xl bg-pink-500/20 text-pink-300 flex items-center justify-center shrink-0 font-extrabold text-sm border border-pink-500/40">
                            ✨
                        </div>
                        <div>
                            <span class="font-bold text-white block">2 AI Lifelines</span>
                            <span class="text-xs text-blush-300">50:50 Sparkle & Priyanshu's Hint</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-blush-950/70 border border-blush-500/30">
                        <div class="w-9 h-9 rounded-2xl bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0 font-extrabold text-sm border border-purple-500/40">
                            25
                        </div>
                        <div>
                            <span class="font-bold text-white block">Syllabus Questions</span>
                            <span class="text-xs text-blush-300">Pandas DataFrames, Series & Matplotlib</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Start Button -->
            <button id="startQuizBtn" class="group relative inline-flex items-center justify-center px-10 py-4 font-display font-extrabold text-lg text-blush-950 bg-gradient-to-r from-amber-300 via-blush-200 to-pink-300 rounded-2xl shadow-xl shadow-blush-500/30 hover:shadow-2xl hover:shadow-amber-400/40 hover:scale-105 active:scale-95 transition-all duration-300">
                <span class="flex items-center gap-3">
                    <span>Begin Your Magical IP Quest ✨</span>
                    <i class="fa-solid fa-heart text-blush-700 text-lg group-hover:scale-125 transition-transform"></i>
                </span>
            </button>
        </section>

        <!-- ================= 2. ACTIVE QUIZ SCREEN ================= -->
        <section id="quizScreen" class="w-full hidden">
            
            <!-- Top Progress, Score & Streak Bar -->
            <div class="mb-4 space-y-2">
                <div class="flex items-center justify-between text-xs font-bold text-blush-200">
                    <span id="questionCounter" class="flex items-center gap-1.5">
                        <i class="fa-solid fa-heart text-blush-400"></i> Question 1 of 25
                    </span>

                    <!-- Streak Badge -->
                    <div id="streakBadge" class="hidden px-3 py-1 rounded-full bg-gradient-to-r from-amber-400 to-blush-500 text-blush-950 font-extrabold text-xs shadow-lg animate-bounce flex items-center gap-1">
                        <i class="fa-solid fa-fire text-amber-100"></i>
                        <span id="streakText">2x STREAK COMBO!</span>
                    </div>

                    <span id="scoreTracker" class="text-amber-300 font-mono text-xs sm:text-sm bg-blush-950/80 px-3 py-1 rounded-full border border-amber-400/30">
                        Score: 0 / 50
                    </span>
                </div>

                <!-- Heart Progress Bar -->
                <div class="w-full h-3 bg-blush-950/80 rounded-full overflow-hidden p-0.5 border border-blush-800/60 shadow-inner">
                    <div id="progressBar" class="h-full bg-gradient-to-r from-blush-400 via-pink-400 to-amber-300 rounded-full transition-all duration-300 w-0"></div>
                </div>
            </div>

            <!-- Lifelines & Hint Bar -->
            <div class="mb-4 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <button id="lifeline5050" class="px-3 py-1.5 rounded-xl bg-blush-900/70 border border-blush-400/40 hover:bg-blush-800 text-blush-100 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                        <span>50:50 Lifeline</span>
                    </button>
                    <button id="lifelineHint" class="px-3 py-1.5 rounded-xl bg-blush-900/70 border border-blush-400/40 hover:bg-blush-800 text-blush-100 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-lightbulb text-amber-300"></i>
                        <span>Priyanshu's Hint</span>
                    </button>
                </div>

                <!-- Category Tag -->
                <span id="categoryTag" class="px-3 py-1 rounded-full text-[10px] sm:text-xs font-extrabold uppercase tracking-wider bg-blush-500/20 text-blush-200 border border-blush-400/30">
                    Pandas DataFrames
                </span>
            </div>

            <!-- Hint Display Box -->
            <div id="hintBox" class="hidden mb-4 p-3.5 rounded-2xl bg-amber-500/15 border border-amber-400/40 text-amber-200 text-xs font-semibold animate-pop-in flex items-start gap-2.5">
                <span class="text-xl shrink-0">💡</span>
                <div>
                    <span class="font-bold block text-amber-300 mb-0.5">Priyanshu Gupta's Hint:</span>
                    <span id="hintText"></span>
                </div>
            </div>

            <!-- Feedback Banner -->
            <div id="feedbackBanner" class="hidden mb-4 p-3 rounded-2xl font-bold text-center text-xs sm:text-sm transition-all animate-pop-in flex items-center justify-center gap-2 shadow-lg">
                <span id="feedbackIcon" class="text-2xl"></span>
                <span id="feedbackText"></span>
            </div>

            <!-- Question Card -->
            <div id="questionCard" class="glass-card rounded-3xl p-5 sm:p-7 shadow-2xl relative overflow-hidden transition-all duration-300">
                
                <!-- Mascot Boy Header Row -->
                <div class="flex items-center justify-between gap-4 mb-4 pb-4 border-b border-blush-800/50">
                    <div class="flex items-center gap-3">
                        <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-blush-400 to-amber-300 p-0.5 shrink-0 shadow-md">
                            <div class="w-full h-full bg-blush-950 rounded-[14px] flex items-center justify-center overflow-hidden relative">
                                <svg id="questionCharacterSvg" class="w-14 h-14 sm:w-18 sm:h-18 animate-boy-bounce" viewBox="0 0 100 100" fill="none">
                                    <!-- Injected via JS -->
                                </svg>
                            </div>
                        </div>
                        <div>
                            <span id="characterName" class="text-xs sm:text-sm font-extrabold text-amber-300 block">PRIYANSHU GUPTA</span>
                            <span id="characterStateText" class="text-[11px] text-blush-200/90 italic font-romantic block">"Let's solve this Python puzzle!"</span>
                        </div>
                    </div>

                    <div class="text-right">
                        <span class="text-xs font-extrabold text-amber-300 block">
                            +2 Marks
                        </span>
                        <span class="text-[10px] text-blush-300 uppercase tracking-widest font-semibold block">CBSE Board Standard</span>
                    </div>
                </div>

                <!-- Question Text -->
                <h2 id="questionText" class="text-base sm:text-lg font-bold text-white mb-4 leading-relaxed">
                    Loading Question...
                </h2>

                <!-- Code Snippet Box -->
                <div id="codeSnippetBox" class="hidden mb-5 p-3.5 rounded-xl bg-slate-950/90 font-mono text-xs sm:text-sm text-emerald-300 border border-blush-800/60 overflow-x-auto shadow-inner">
                    <pre><code id="codeSnippetText"></code></pre>
                </div>

                <!-- 4 Options Container -->
                <div id="optionsContainer" class="space-y-2.5">
                    <!-- Options generated dynamically -->
                </div>
            </div>

            <!-- Bottom Navigation Bar -->
            <div class="flex items-center justify-between mt-5">
                <button id="quitBtn" class="px-4 py-2 text-xs font-bold text-blush-300 hover:text-blush-100 transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left"></i> Home
                </button>
                <button id="nextBtn" disabled class="px-8 py-3 bg-gradient-to-r from-amber-300 via-blush-200 to-pink-300 hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed text-blush-950 font-display font-extrabold rounded-2xl shadow-lg transition-all flex items-center gap-2">
                    <span id="nextBtnText">Next Question</span>
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>
        </section>

        <!-- ================= 3. FINAL RESULTS SCREEN ================= -->
        <section id="resultScreen" class="w-full hidden animate-pop-in py-2">
            <div class="glass-card rounded-3xl p-6 sm:p-10 shadow-2xl text-center max-w-2xl mx-auto relative overflow-hidden">
                
                <!-- Boy Mascot Result Banner -->
                <div class="relative w-28 h-28 mx-auto rounded-full bg-gradient-to-tr from-amber-300 via-blush-400 to-pink-400 p-1 shadow-2xl mb-4 animate-pulse-glow">
                    <div class="w-full h-full bg-blush-950 rounded-full flex items-center justify-center overflow-hidden">
                        <svg id="resultCharacterSvg" class="w-24 h-24 animate-boy-bounce" viewBox="0 0 100 100" fill="none">
                            <!-- Injected dynamically -->
                        </svg>
                    </div>
                </div>

                <div id="rankBadgeTag" class="inline-block px-4 py-1 rounded-full text-xs font-extrabold uppercase tracking-widest bg-amber-400 text-blush-950 shadow-md mb-2">
                    PYTHON CHAMPION
                </div>

                <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white mb-1" id="resultGradeTitle">
                    Wonderful Job!
                </h2>
                <p class="text-blush-200 text-xs sm:text-sm mb-6 font-romantic" id="resultSubtitle">
                    You completed all 25 Class 12 IP Python Questions!
                </p>

                <!-- Score Box -->
                <div class="bg-blush-950/80 border border-blush-500/30 p-5 rounded-3xl mb-6 max-w-md mx-auto shadow-inner">
                    <span class="text-xs font-bold uppercase tracking-widest text-blush-300 block mb-1">Your Total Marks</span>
                    <div class="text-5xl font-display font-black bg-gradient-to-r from-amber-300 via-blush-100 to-pink-200 bg-clip-text text-transparent mb-1">
                        <span id="finalScoreDisplay">0</span> <span class="text-2xl text-blush-300 font-sans">/ 50</span>
                    </div>
                    <span id="percentageDisplay" class="text-sm font-extrabold text-emerald-300">0% Score</span>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 text-left">
                    <div class="p-3.5 rounded-2xl bg-blush-950/70 border border-blush-500/30">
                        <span class="text-[10px] font-bold text-blush-300 block uppercase">Total Questions</span>
                        <span class="text-xl font-bold text-white">25</span>
